{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Közérthetőségi szótár",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "par"
  ],
  "properties": {
    "par": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kifejezes",
          "regex",
          "javaslat",
          "szabaly",
          "forrasok"
        ],
        "properties": {
          "kifejezes": {
            "type": "string",
            "minLength": 1
          },
          "regex": {
            "type": "string",
            "minLength": 1,
            "description": "Python-regex, kis- és nagybetű nem számít."
          },
          "javaslat": {
            "type": "string",
            "minLength": 1
          },
          "szabaly": {
            "type": "string",
            "pattern": "^K[0-9]{3}$"
          },
          "forrasok": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+#[0-9]{3}$"
            }
          },
          "mikor_nem": {
            "type": "string",
            "minLength": 1,
            "description": "Mikor ne cseréld."
          }
        }
      }
    }
  }
}
